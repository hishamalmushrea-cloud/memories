# Gradle
.gradle/
build/
app/build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
.kotlin/
captures/
.cxx/

# Local configuration and secrets -- never commit these. A leaked signing key
# cannot be rotated: Android only installs an update signed by the certificate
# the installed copy already trusts, so a key in the history costs the app's
# identity, not one release. ci/check-keystore-leaks.py enforces this against
# the Git index; this list only keeps the files from being added by accident.
local.properties
*.keystore
*.jks
*.p12
*.pfx
keystore.properties
signing.properties
# The release key travels to CI base64-encoded; the encoded copy is the same
# secret in a different alphabet and must not be committed either.
*.b64
*keystore-password*
*keystore*.txt
keystore*.base64
release-signing/

# OS noise
.DS_Store
Thumbs.db

# Room's exported schema is generated by KSP. Commit it deliberately (it is
# review history for migrations); until then keep it out of the build verdict.
app/schemas/

# Signing reports / outputs that must not be tracked
*.apk.idsig
app/release/
/release/

# Python / tooling caches inside the repo
__pycache__/
.pytest_cache/
