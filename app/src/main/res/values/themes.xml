<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole UI; this theme only carries the window background
         and the status bar treatment before the first frame. -->
    <style name="Theme.MemoryMap" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/memorymap_background</item>
    </style>
</resources>
