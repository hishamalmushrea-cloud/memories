<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves this device through a platform backup.

  `android:allowBackup="false"` already says so, and this file is the same
  statement in the form Android 12 and later read: from API 31 the manifest
  attribute `android:dataExtractionRules` is what the system consults, and
  leaving it out is what the `DataExtractionRules` lint check points at.

  Every domain is excluded rather than left to the default, because the default
  is "everything". A user's memories, the diary and the media live in the app's
  private storage and the app has an export of its own - the backup folder in
  Settings - which is the only copy the user has chosen to make.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
